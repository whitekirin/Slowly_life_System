# 複製此檔案為 .env.production，填入正式環境的真實值，並確保它不會進 git
# （.gitignore 已經排除 .env.production）。docker compose 會自動讀取同目錄下的
# .env / .env.production（用 `docker compose --env-file .env.production ...` 指定）。

# 你的網域（app 服務用它組出各種回傳連結；HTTPS 由 Cloudflare Tunnel 在邊緣處理，
# 不是本機的憑證機制，所以這裡純粹是給 app 組 URL 用）
DOMAIN=slowlyshops.com

# Cloudflare Zero Trust > Networks > Tunnels 建立 tunnel 時給的 token
# （Docker connector 那個安裝指令裡 --token 後面那一長串）。
# Public Hostname 要在 Cloudflare 後台設定：slowlyshops.com -> http://app:8000
CLOUDFLARE_TUNNEL_TOKEN=

# PostgreSQL
POSTGRES_USER=erp_app
# 產生一組隨機密碼：openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=erp

# JWT 簽章密鑰，務必是隨機值，不要沿用 repo 裡的預設值
# 產生：openssl rand -hex 32
SECRET_KEY=

# 第一次啟動、資料庫還沒有 admin 帳號時，自動建立的預設管理員密碼。
# 務必填一個隨機值，不要沿用開發環境的 password，首次登入後立刻改密碼。
DEFAULT_ADMIN_PASSWORD=

# 從舊的 .env 複製過來即可（LINE Developers Console 申請到的真實憑證）
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_MESSAGING_ACCESS_TOKEN=
# Messaging API channel 自己的 Channel Secret（該 channel 的 Basic settings 分頁，
# 跟上面 LINE_CHANNEL_SECRET 是不同 channel 的不同值），驗證 webhook 簽章用
LINE_MESSAGING_CHANNEL_SECRET=
# 正式環境確定要真的推播 LINE 訊息時才改成 false
LINE_SUPPRESS_SEND=true
# LIFF App 的 ID（LINE Login Channel 底下的 LIFF 分頁申請）。這個值除了給 backend
# 驗證 LIFF ID token 用，也會透過 docker-compose.yml 的 build.args 傳進前端建置
# （Vite 在 build time 內嵌 VITE_LIFF_ID），所以改了這個值之後要重新 build image
# （docker compose --env-file .env.production build app），單純 restart 不會生效。
LIFF_ID=
LIFF_CHANNEL_ID=
