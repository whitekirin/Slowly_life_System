# 複製此檔案為 .env 並填入你自己的值。.env 不會被 git 追蹤。
# 詳細申請步驟見 docs/line-integration-guide.md

# LINE Login channel（用於員工在系統內綁定自己的 LINE 帳號）
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=http://localhost:8000/line/callback

# Messaging API channel（用於系統主動推播訊息，需與上面的 LINE Login channel 掛在同一個 Provider 底下）
LINE_MESSAGING_ACCESS_TOKEN=
# 這個 Channel 自己的 Channel Secret（Messaging API channel 的 Basic settings 分頁，
# 不是上面 LINE Login channel 的那組）。只用來驗證 /line/webhook 收到的 X-Line-Signature，
# 跟上面的 LINE_CHANNEL_SECRET 是兩個不同的值，不要填錯 channel。
LINE_MESSAGING_CHANNEL_SECRET=

# true：不會真的呼叫 LINE API，只寫入 line_delivery.log（開發/測試預設值）
# false：會真的呼叫 LINE API 推播訊息，申請好帳號並填好上面欄位後才能設為 false
LINE_SUPPRESS_SEND=true

# 前端網址，OAuth 綁定完成後導回前端用
FRONTEND_BASE_URL=http://localhost:5173

# LIFF App（LINE 對話內操作用，例如填寫進貨單）。詳見 docs/line-liff-actions-plan.md。
# 需要在 LINE Developers Console 另外註冊一個 LIFF App 才有值，未填不影響其他既有功能。
LIFF_ID=
# 留空時預設 fallback 成 LINE_CHANNEL_ID（多數情況 LIFF App 掛在同一個 LINE Login channel 下）
LIFF_CHANNEL_ID=

# 留空 = 沿用本機 SQLite 檔案（開發預設）。
# 正式環境（Docker）設成 SQLAlchemy 連線字串，例如：
# postgresql+psycopg://<user>:<password>@db:5432/<database>
DATABASE_URL=

# JWT 簽章密鑰。本機開發可留預設值，正式環境務必覆寫成隨機字串
# （例如執行 `openssl rand -hex 32` 產生）。
SECRET_KEY=your-secret-key-keep-it-secret-change-me-in-production

# 第一次啟動、資料庫還沒有 admin 帳號時，自動建立的預設管理員密碼。
# 本機開發可留預設值 password；正式環境務必覆寫成隨機字串，且首次登入後立刻改密碼。
DEFAULT_ADMIN_PASSWORD=password

# 這個 backend 自己對外可被存取的網址，用來組出回傳給前端/寫進外寄郵件的連結
# （上傳檔案網址、行銷信追蹤像素等）。開發預設 :8000；正式環境設成部署網域，
# 例如 https://slowlyshops.com。
PUBLIC_BASE_URL=http://localhost:8000

# 允許呼叫 API 的來源網域，逗號分隔。正式環境設成部署網域，例如 https://slowlyshops.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
